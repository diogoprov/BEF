\documentclass[a4paper]{article}

\title{Analysis from Provete et al. 2014. Phylogenetic and taxononomic diversity interactively influence freshwater ecosystem functioning}

\author{Diogo B. Provete}

\begin{document}

\maketitle

These are the analyses I run for the Amy's experiment (Downing \& Leibold 2002 Nature) in which I investigated the effects of phylogenetic diversity on ecosystem functioning. This is one of my PhD. dissertation chapters.

\section*{Loading R packages and data input}

<<packages, warning=FALSE, message=FALSE, cache=FALSE, results='hide'>>=
library(spacodiR)#0.13.0115
library(picante)#1.6-2
library(apTreeshape)#1.4-5
library(phytools)#0.4-21
library(ggplot2)#1.0.0
#Run in R 3.0.3
@

<<data>>=
dados <- read.csv("data_diogo.csv", header = T, sep = ",")
head(dados)
attach(dados)

trata=factor(div)
COMP<-factor(comp)
TIME<-factor(time)

me<-aggregate(prod, list(trata, PD), "mean")
dec.plot<-aggregate(dc, list(trata, PD), "mean")
names(dec.plot)=c("Diversity", "PD", "Decomposition")#renaming the columns to make the plot
resp.plot<-aggregate(resp, list(trata, PD), "mean")
names(resp.plot)=c("Diversity", "PD", "Decomposition")#renaming the columns to make the plot
@

\section*{Phylogeny input and calculating PD variables}

Here I assembled by hand a phylogeny of all species in the
treatments using Mesquite. Then, I looked for node ages in 
www.timetree.org. After I got these data, I took the tree 
and the node ages to Phylocom to obtain a pseudochronogram 
by using BLADJ. From that, I imported the dated tree again into R. 

<<Phylogeny>>=
#---Data input and manipulation of trees to be dated in Phylocom
phylog.2002=read.tree("undated_tree.txt")
phyloNodes=makeNodeLabel(phylog.2002)
write.tree(phyloNodes, file="phylo_2002.txt")

#---Working wih dated phylogenies
amy.nature=read.tree("phylog_dated_2002.txt")
plot(amy.nature, cex=0.8);axisPhylo()
nodelabels(node=c(20, 21, 22, 23, 24,27, 29, 31, 33, 32),
bg="black", frame="circle", cex=0.3)
title("Downing & Leibold (2002;2010)", xlab="Mya")
@
\begin{figure}
\caption{Dated phylogeny with the 19 species that remained at the end of the experiment. The black dots indicate the nodes with known ages used to date the tree}
\end{figure}

\subsection*{Tree shape metrics}

Since previous studies suggesteed that tree imbalance and 
rootness could alter the influence of phylogeny on
ecosystem functioning, I calculated two commonly used metrics, 
$I_{c}$ and $Pybus'\gamma$.

<<Tree shape metrics>>=
#---Playing with tree shape metrics
treeNature=as.treeshape(amy.nature)
set.seed(1002)
colless.test(treeNature)#Ic=0.750, the tree is more balanced than 
#predicted by the Yule model 
z=ltt(amy.nature, plot=F, gamma=F)
set.seed(1001)
gammatest(z)#gamma=0.40; P=0.686
@

\subsection*{Calculating PD variables}

Importing data from the supplementary material of 
Downing \& Leibold (2002) that describes final 
species composition in each treatment to calculate PD.

<<Calculating PD>>=
#---Species composition per treatments, calculating PD
treat=read.table("treat.txt", h=T)

#--Independent on species richness
mpd.nature=mpd(t(treat),cophenetic(amy.nature))#mpd

#--Dependent on species richness
PD.nature=picante::pd(t(treat), amy.nature)#Faith's PD
@

Pasting the new variables into the dataset.

<<Data handling>>=
#---Binding phylogenetic diversity variables into data file

d<-dados[order(dados$comp),]#sorting data by composition
d$mpd<-rep(mpd.nature,each=12)#repeat MPD 12 times
cor(cbind(mpd.nature,PD.nature[,1]))#r=0.407
@

Exploring the variation in PD variables in relation to species composition (treatment) and species richness.

<<PD vs. richness plots>>=
#---Plots variation in PD and MPD
par(mfrow=c(2,2))
plot(PD.nature[[1]]~PD.nature[[2]], xlab="Species richness", ylab="Faith's PD")
plot(PD.nature[[1]], xlab="Species composition", ylab="Faith's PD")

plot(mpd.nature~PD.nature[[2]], xlab="Species richness", ylab="MPD")
plot(mpd.nature, xlab="Species composition", ylab="MPD")
@

Visualizing species incidence in each treatment plotted on the regional phylogeny

<<Species incidence on the regional phylogeny>>=
#---Distribution of species assigned to treatments on regional phylogeny
spa=as.spacodi(t(treat))
phy.dotplot(spa, phy=amy.nature, tips.adj=c(0.50,0.55), lab.adj=c(0,1))
@

\begin{figure}
\caption{Regional phylogeny showing the combination of species present in each
of the 21 species compositions manipulated in the experiment}
\end{figure}

\section*{Models for the influence of PD on ecosystem functioning}

I run a rm-ANOVA for nested designs to investigate the influence of PD on productivity, decomposition, and respiration PD, nested within each treatment (=species richness).

<<Productivity>>=
##--- Linear Model with nested design and repeated measures for Productivity
mode<-lm(prod~trata+trata/COMP+TIME, data=dados)
mod1<-anova(mode)
mode2<-lm(prod~trata+PD+TIME, data=dados)
mod2<-anova(mode2)
pf(mod1[1,3]/mod1[3,3], 2, 18, lower.tail=F)#valor de P para efeito do tratamento (diversidade)

##-- Quadratic Model with nested design and repeated measures for Productivity
modeq<-lm(prod~trata+PD+I(PD^2)+TIME, data=dados)#model with PD as a quadratic term
anova(modeq)#the quadratic term is significant
summary(modeq)#to get the parameters and estimated values of the model
pred.mod<-predict(modeq)#predicted values for each observation
dados$pred<-pred.mod#binding to the data frame

me$pred<-aggregate(dados$pred, list(trata, PD), "mean")$x

mq<-lm(prod~PD+I(PD^2), data=dados)#to get the values without time, to make the plot 
#of the quadratic model
anova(mq)
summary(mq)
coef(mq)
@

<<Productivity Plot>>=
#to make the plot
names(me)=c("Diversity", "PD", "Productivity", "pred")#renaming the columns to make the plot
me$pred<-coef(mq)[1]+coef(mq)[2]*me$PD+coef(mq)[3]*me$PD^2#adding the predicted values for PD by the quadratic model

#width represents PD
ggplot(me,aes(x=PD, y=Productivity, colour=Diversity))+
	geom_line()

ggplot(me,aes(x=PD, y=Productivity, colour=Diversity))+
	geom_boxplot()

#same version but bw, instead
ggplot(me,aes(x=Diversity, y=Productivity))+
	geom_boxplot()

gf<-as.data.frame(cbind(rep(1:2, each=21), rbind(cbind(me$PD, me$Productivity), cbind(me$PD, me$pred))))
names(gf)=c("Group", "PD", "Productivity")

ggplot(gf,aes(x=PD, y=Productivity, group=Group))+
geom_line()

#Final plot showing the variation in PD in red and the quadratic model in blue
ggplot(me, aes(x=PD))+
	geom_line(aes(y=pred), colour="blue")+
	geom_line(aes(y=Productivity), colour="red")

#same version but bw, instead
gf<-as.data.frame(cbind(rep(1:2, each=21), rbind(cbind(me$PD, me$Productivity), cbind(me$PD, me$pred))))
names(gf)=c("Group", "PD", "Productivity")
@

<<Model for Decomposition>>=
modeL<-lm(dc~trata+trata/COMP+TIME, data=dados)
modee1<-anova(modeL)
modee2<-lm(dc~trata+PD+TIME, data=dados)
md2<-anova(modee2)
pf(modee1[1,3]/modee1[3,3], 2, 18, lower.tail=F)#valor de P para efeito do tratamento (diversidade)
modeqdec<-lm(dc~trata+PD+I(PD^2)+TIME, data=dados)#model with PD as a quadratic term
anova(modeqdec)#the quadratic term is significant
@

<<Plotting Decomposition>>=
ggplot(dec.plot,aes(x=PD, y=Decomposition, colour=Diversity))+
	geom_line()
@

<<Model for Respiration>>=
m.resp.lin<-lm(resp~trata+PD+TIME, data=dados)
res.resp.lin<-anova(m.resp.lin)
pf(res.resp.lin[1,3]/res.resp.lin[3,3], 2, 18, lower.tail=F)#valor de P para efeito do tratamento (diversidade)

mdeq<-lm(resp~trata+PD+I(PD^2)+TIME, data=dados)#model with PD as a quadratic term
anova(mdeq)#the quadratic term is significant

modq<-lm(resp~PD+I(PD^2), data=dados)#to get the values without time, to make the plot of the quadratic model
anova(modq)
summary(modq)
coef(modq)
resp.pred<-predict(modq)#predicted values for each observation
dados$resp.pred<-resp.pred#binding to the data frame

resp.plot$resp.pred<-aggregate(dados$resp.pred, list(trata, PD), "mean")$x

resp.plot$resp.pred<-coef(modq)[1]+coef(modq)[2]*resp.plot$PD+coef(modq)[3]*resp.plot$PD^2#adding the predicted values 
#for PD by the quadratic model
names(resp.plot)=c("Diversity", "PD", "Respiration", "pred")#renaming the columns to make the plot
@

<<Plots for Respiration>>=
#Final plot showing the variation in PD in red and the quadratic model in blue
ggplot(resp.plot, aes(x=PD))+
	geom_line(aes(y=pred), colour="blue")+
	geom_line(aes(y=Respiration), colour="red")

#Just another version with data as points and model as line
ggplot(resp.plot, aes(x=PD)) + 
	geom_line(aes(y=pred), colour="blue", linetype="solid", size=1) + 
	geom_point(aes(y=Respiration), colour="red", size=4, shape=21, fill="white")
@


\subsubsection*{Productivity}

<<Model Selection Productivity>>=
#-with PD
prod.PD<-lm(prod~trata+PD+TIME, data=dados)
mq.prodPD<-lm(prod~trata+PD+I(PD^2)+TIME, data=dados)

#-With MPD
prod.pd<-lm(prod~trata+mpd+TIME, data=d)
mq.mpd<-lm(prod~trata+mpd+I(mpd^2)+TIME, data=d)

\subsubsection*{Respiration}

<<Model selection Respiration>>=
#-with PD
resp.PD<-lm(resp~trata+PD+TIME, data=dados)
qpd<-lm(resp~trata+PD+I(PD^2)+TIME, data=dados)

#-With MPD
resp.mpd<-lm(resp~trata+mpd+TIME, data=d)
qmpd<-lm(resp~trata+mpd+I(mpd^2)+TIME, data=d)

\subsubsection*{Decomposition}
<<Model selection Decomposition>>=
#-with PD
qdec<-lm(dc~trata+PD+I(PD^2)+TIME, data=dados)
anova(qdec)
#-With MPD
decqmpd<-lm(dc~trata+mpd+I(mpd^2)+TIME, data=d)
anova(decqmpd)

